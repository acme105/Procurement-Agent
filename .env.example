# Copy to ~/.config/aerchain/openai.env and ~/.config/aerchain/smtp.env (or export these). Never commit real values.
OPENAI_API_KEY=
AERCHAIN_MODEL=gpt-6-luna

# Email sending (optional: without it, download the PDF and forward it yourself). For Gmail use an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Procurement <you@example.com>

# Public address of this app, used in the vendor upload link (default: the address you opened it on)
AERCHAIN_PUBLIC_URL=
# The one shared password on the sign-in page. Leave empty on your own machine; ALWAYS set it on any server
AERCHAIN_BUYER_PASSWORD=
# Optional overrides
# AERCHAIN_CATALOG=data/catalog.csv
# AERCHAIN_STATE=state
# AERCHAIN_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: email an alert to this address when someone visits or signs in (set on the server only)
# AERCHAIN_VISIT_ALERT_TO=
# AERCHAIN_VISIT_IGNORE_IPS=            # comma-separated addresses to skip (your own)
